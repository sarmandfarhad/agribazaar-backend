{
    "preset": "laravel",
    "rules": {
        "binary_operator_spaces": {
            "default": "single_space",
            "operators": {
                "=>": null
            }
        },
        "concat_space": {
            "spacing": "one"
        },
        "not_operator_with_successor_space": false,
        "unary_operator_spaces": false,
        "single_line_empty_body": false,
        "phpdoc_align": false
    },
    "exclude": [
        "bootstrap/cache"
    ]
}
